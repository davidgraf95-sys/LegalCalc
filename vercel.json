{
  "ignoreCommand": "[ \"$VERCEL_GIT_COMMIT_REF\" != \"main\" ] && exit 0; B=${VERCEL_GIT_PREVIOUS_SHA:-HEAD^}; git rev-parse --verify \"$B\" >/dev/null 2>&1 || exit 1; ! git diff --name-only \"$B\" HEAD | grep -qvE '\\.md$|^(bibliothek|archiv|docs|\\.claude)/'",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/international", "destination": "/gesetze?ebene=international", "permanent": true }
  ],
  "rewrites": [
    { "source": "/((?!(?:normtext|rechtsprechung|materialien|such-index|assets)/.*\\.[a-zA-Z0-9]+).*)", "destination": "/app" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self' https://www.zefix.ch https://api3.geo.admin.ch https://entscheidsuche.ch; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/normtext/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; frame-ancestors 'self'; object-src 'self'" },
        { "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }
      ]
    },
    {
      "source": "/rechtsprechung/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }
      ]
    },
    {
      "source": "/materialien/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }
      ]
    }
  ]
}
